# ====================================================================
# Environment Variables & API Credentials
# Rename this file to '.env' and fill in your keys
# ====================================================================

# Google Gemini API Key (Recommended for highlight detection and metadata)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# (Optional) OpenAI API Key if you switch llm_provider to 'openai' in config.yaml
OPENAI_API_KEY=your_openai_api_key_here

# Path to your Google Cloud OAuth2 Client Secret JSON file for YouTube Data API v3
# Download from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
YOUTUBE_CLIENT_SECRET_FILE=./client_secrets.json

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
